{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/schemas/events/order.shipment-created.v1.schema.json",
  "allOf": [
    {"$ref": "event-envelope.v1.schema.json"},
    {"type": "object", "properties": {
      "eventType": {"const": "order.shipment-created.v1"},
      "aggregateType": {"const": "Shipment"},
      "producer": {"const": "order-service"},
      "data": {"$ref": "#/$defs/data"}
    }}
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": ["shipmentId", "orderId", "customerId", "sellerId", "status", "lines"],
      "properties": {
        "shipmentId": {"type": "string", "format": "uuid"},
        "orderId": {"type": "string", "format": "uuid"},
        "customerId": {"type": "string", "format": "uuid"},
        "sellerId": {"type": "string", "format": "uuid"},
        "status": {"const": "CREATED"},
        "carrier": {"type": ["string", "null"], "maxLength": 80},
        "trackingNumber": {"type": ["string", "null"], "maxLength": 120},
        "lines": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["orderItemId", "variantId", "quantity"],
            "properties": {
              "orderItemId": {"type": "string", "format": "uuid"},
              "variantId": {"type": "string", "format": "uuid"},
              "quantity": {"type": "integer", "minimum": 1, "maximum": 99}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
