{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/schemas/events/event-envelope.v1.schema.json",
  "title": "MarketFlow Event Envelope v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "producer",
    "schemaVersion",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.v[1-9][0-9]*$"
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causationId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "schemaVersion": {
      "const": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
