{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/schemas/events/order.order-created.v1.schema.json",
  "allOf": [
    {"$ref": "event-envelope.v1.schema.json"},
    {"type": "object", "properties": {
      "eventType": {"const": "order.order-created.v1"},
      "aggregateType": {"const": "Order"},
      "producer": {"const": "order-service"},
      "data": {"$ref": "#/$defs/orderCreated"}
    }}
  ],
  "$defs": {
    "orderCreated": {
      "type": "object",
      "required": ["orderId", "reservationTtlSeconds", "lines"],
      "properties": {
        "orderId": {"type": "string", "format": "uuid"},
        "reservationTtlSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "lines": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "required": ["variantId", "quantity"],
            "properties": {
              "variantId": {"type": "string", "format": "uuid"},
              "quantity": {"type": "integer", "minimum": 1, "maximum": 99}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
